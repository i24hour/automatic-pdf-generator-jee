FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Ensure logs are flushed immediately
ENV PYTHONUNBUFFERED=1

# Install C compiler and build tools first (needed to compile pycairo, manimpango, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    meson \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Install system dependencies for LaTeX and video generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    texlive-latex-base \
    texlive-fonts-recommended \
    texlive-fonts-extra \
    texlive-latex-extra \
    texlive-science \
    lmodern \
    pdf2svg \
    texlive-binaries \
    ffmpeg \
    libcairo2-dev \
    libpango1.0-dev \
    libgdk-pixbuf-xlib-2.0-dev \
    pkg-config \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*
